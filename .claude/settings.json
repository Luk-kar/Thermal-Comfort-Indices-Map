{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask_on_file_io.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": ".claude/hooks/radon_check.sh" }]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.git/**)",
      "Edit(~/.gitconfig)",
      "Bash(*.claude/hooks*)",
      "Bash(*.git/config*)",
      "Bash(*.git/hooks*)",
      "Bash(*.gitconfig*)",
      "Bash(git config *)",
      "Bash(git commit *)",
      "Bash(git commit-tree *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git am *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git update-ref *)",
      "Bash(git replace *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git gc *)",
      "Bash(git prune*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -f*)",
      "Bash(git branch --force*)",
      "Bash(git branch -m*)",
      "Bash(git branch -M*)",
      "Bash(git branch --move*)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -B*)",
      "Bash(git switch -f*)",
      "Bash(git switch -C*)",
      "Bash(git switch --force*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git clean *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)",
      "Bash(git --namespace*)",
      "Bash(git --* commit *)",
      "Bash(git --* push *)",
      "Bash(git --* rebase *)",
      "Bash(git --* reset *)",
      "Bash(gh api*)",
      "Bash(gh auth*)",
      "Bash(gh secret*)",
      "Bash(gh release*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo sync*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*)",
      "Bash(rm -ir*)",
      "Bash(rm -iR*)",
      "Bash(rm -if*)",
      "Bash(rm -vr*)",
      "Bash(rm -vR*)",
      "Bash(rm -vf*)",
      "Bash(rm -dr*)",
      "Bash(rm -dR*)",
      "Bash(rm -df*)",
      "Bash(rm * -r*)",
      "Bash(rm * -R*)",
      "Bash(rm * -f*)",
      "Bash(rm *--recursive*)",
      "Bash(rm *--force*)",
      "Bash(rm *--no-preserve-root*)",
      "Bash(command rm *)",
      "Bash(/bin/rm *)",
      "Bash(/usr/bin/rm *)",
      "Bash(xargs *rm *)",
      "Bash(xargs *sh *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(dd *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(sh -*c *)",
      "Bash(zsh -*c *)",
      "Bash(dash -*c *)",
      "Bash(eval *)"
    ]
  }
}
